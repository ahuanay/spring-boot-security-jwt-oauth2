# ==========================================
# PLANTILLA DE VARIABLES DE ENTORNO
# ==========================================
PROFILE=dev
PORT=8081

APP_TIMEZONE=America/Lima

# Base de Datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=auth_db
DB_USER=postgres
DB_PASSWORD=postgres

# JPA / Flyway
JPA_DDL_AUTO=validate
JPA_SHOW_SQL=false
JPA_FORMAT_SQL=true
FLYWAY_ENABLED=true

# OAuth2 GitHub (Consigue tus credenciales en GitHub Developer Settings)
GITHUB_CLIENT_ID=tu_github_client_id_aqui
GITHUB_CLIENT_SECRET=tu_github_client_secret_aqui

# OAuth2 Google (Consigue tus credenciales en Google Cloud Console)
GOOGLE_CLIENT_ID=tu_google_client_id_aqui
GOOGLE_CLIENT_SECRET=tu_google_client_secret_aqui

# JWT Configuración
JWT_SECRET=debes_cambiar_esta_clave_genera_una_de_al_menos_64_caracteres
JWT_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=3600000

# Recuperación de contraseña
PASSWORD_RESET_EXPIRATION_MINUTES=30
PASSWORD_RESET_FRONTEND_URL=http://localhost:4200/auth/restablecer-contrasena

# Rol por defecto al registrar usuarios vía OAuth2
APP_DEFAULT_ROLE=PACIENTE

# Email de recuperación
MAIL_MODE=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=auth@mail.com
SMTP_PASSWORD=

# Doble factor de autenticación (OTP por email)
MFA_OTP_EXPIRATION_MINUTES=5
MFA_OTP_MAX_ATTEMPTS=5
MFA_OTP_RESEND_COOLDOWN_SECONDS=60